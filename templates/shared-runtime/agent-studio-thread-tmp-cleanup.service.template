[Unit]
Description=Remove regenerable data of idle agent-studio threads (workspace copies 3d, temp dirs per admin retention)

[Service]
Type=oneshot
Environment=AGENT_STUDIO_DATA_ROOT=__DATA_ROOT__
Environment=SHARED_RUNTIME_STATE_ROOT=__STATE_ROOT__
ExecStart=/usr/local/sbin/agent-studio-thread-tmp-cleanup
Nice=19
IOSchedulingClass=idle
