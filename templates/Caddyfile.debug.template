{$DEBUG_DOMAIN}:{$DEBUG_HTTPS_PORT} {
  encode zstd gzip
  root * {$DEBUG_UI_DIST_ROOT}

  @chat_api path /api/chat/* /api/session /api/threads /api/threads/* /api/portal/* /api/fs/* /api/ai-response-reviews /api/ai-response-reviews/* /api/integrations/crest/* /api/integrations/zendesk/* /api/action-connectors/* /openai/* /public-api/thread-shares/* /public-api/thread-shares
  handle @chat_api {
    reverse_proxy {$DEBUG_CHAT_UPSTREAM_HOST}:{$DEBUG_CHAT_UPSTREAM_PORT}
  }

  @api path /api/* /public-api/* /healthz
  handle @api {
    reverse_proxy {$DEBUG_ADMIN_UPSTREAM_HOST}:{$DEBUG_ADMIN_UPSTREAM_PORT}
  }

  handle /internal/* {
    respond 404
  }

  @missing_js_asset {
    path /assets/*.js
    not file
  }
  handle @missing_js_asset {
    rewrite * /stale-asset-reload.js
    header Cache-Control "no-store"
    file_server
  }

  handle /assets/* {
    file_server
  }

  handle /version.json {
    header Cache-Control "no-store"
    file_server
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
