NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Database connection used by Prisma and the backend runtime.
DATABASE_URL=postgresql://agentstudio:CHANGE_ME@127.0.0.1:5432/agent_studio?schema=public

# App runtime settings.
DEFAULT_MODEL=CHANGE_ME
DEFAULT_REASONING_EFFORT=high
DEFAULT_WORKSPACE=/usr/local/agent-studio/data/workspaces
SESSION_WORKSPACE_ROOT=/usr/local/agent-studio/sessions
WORKSPACE_WHITELIST=/usr/local/agent-studio/data/workspaces
THREAD_STORE_FILE=/usr/local/agent-studio/data/threads.json
UPLOAD_TEMP_ROOT=/usr/local/agent-studio/data/session-uploads
BRANDING_ASSET_ROOT=/usr/local/agent-studio/data/branding-assets
KNOWLEDGE_SET_STORAGE_ROOT=/usr/local/agent-studio/data/knowledge-sets
SESSION_COOKIE_NAME=agent_studio_session
SESSION_COOKIE_SECRET=CHANGE_ME
SESSION_COOKIE_SECURE=true
APP_BASE_URL=https://CHANGE_ME
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_FROM=
AUTH_EMAIL_DEBUG=false

# Optional integrations.
AGENT_API_TOKEN=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=
DINGTALK_SCOPE=openid
DINGTALK_ALERT_AGENT_ID=
DINGTALK_ALERT_USER_IDS=
ORG_SYNC_ENABLED=false
ORG_SYNC_INTERVAL_MINUTES=1440
LEGACY_THREAD_OWNER_ID=
API_BASE_URL=/api
