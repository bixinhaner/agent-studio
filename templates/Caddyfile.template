{$DOMAIN} {
  encode zstd gzip
  root * {$UI_DIST_ROOT}

  # Host-specific route extensions live outside Agent Studio's generated
  # configuration. An empty glob is valid, so fresh installations need no
  # additional setup while co-hosted applications survive future deploys.
  import /etc/caddy/includes/*.routes

  @chat_api path /api/chat/* /api/session /api/threads /api/threads/* /api/portal/* /api/fs/* /api/ai-response-reviews /api/ai-response-reviews/* /api/integrations/crest/* /api/integrations/zendesk/* /api/action-connectors/* /openai/* /public-api/thread-shares/* /public-api/thread-shares
  handle @chat_api {
    reverse_proxy {$CADDY_CHAT_UPSTREAM_HOST}:{$CADDY_CHAT_UPSTREAM_PORT}
  }

  @api path /api/* /public-api/* /healthz
  handle @api {
    reverse_proxy {$CADDY_ADMIN_UPSTREAM_HOST}:{$CADDY_ADMIN_UPSTREAM_PORT}
  }

  handle /internal/* {
    respond 404
  }

  @missing_js_asset {
    path /assets/*.js
    not file
  }
  handle @missing_js_asset {
    rewrite * /stale-asset-reload.js
    header Cache-Control "no-store"
    file_server
  }

  handle /assets/* {
    file_server
  }

  handle /version.json {
    header Cache-Control "no-store"
    file_server
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
