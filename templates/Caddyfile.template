# Blue-green chat: two slots, only the one reporting ready gets new requests.
# A retiring slot answers 503 on /internal/ready and keeps its open streams.
(chat_slot_routing) {
  lb_policy first
  health_uri /internal/ready
  health_interval 1s
  health_timeout 2s
}

{$DOMAIN} {
  encode zstd gzip
  root * {$UI_DIST_ROOT}

  # Host-specific route extensions live outside Agent Studio's generated
  # configuration. An empty glob is valid, so fresh installations need no
  # additional setup while co-hosted applications survive future deploys.
  import /etc/caddy/includes/*.routes

  # Probe the chat event loop independently of the admin API. Bound both
  # connection and response time so a live-but-stuck process cannot hang probes.
  handle /healthz/chat {
    rewrite * /healthz
    header Cache-Control "no-store"
    reverse_proxy {$CADDY_CHAT_UPSTREAM_HOST}:{$CADDY_CHAT_UPSTREAM_PORT} {$CADDY_CHAT_UPSTREAM_HOST}:{$CADDY_CHAT_B_UPSTREAM_PORT} {
      import chat_slot_routing
      transport http {
        dial_timeout 2s
        response_header_timeout 3s
      }
    }
  }

  # Portal usage statistics are stateless reads served by admin, so changes to
  # them never restart the chat service.
  @portal_stats path /api/portal/me/usage /api/portal/me/usage/* /api/portal/me/team-usage /api/portal/me/team-usage/*
  handle @portal_stats {
    reverse_proxy {$CADDY_ADMIN_UPSTREAM_HOST}:{$CADDY_ADMIN_UPSTREAM_PORT} {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  @chat_api path /api/local-bridge/threads/* /api/chat/* /api/session /api/threads /api/threads/* /api/portal/* /api/fs/* /api/ai-response-reviews /api/ai-response-reviews/* /api/integrations/crest/* /api/integrations/zendesk/* /api/action-connectors/* /openai/* /public-api/thread-shares/* /public-api/thread-shares
  # Retrying holds new requests during a slot switch instead of failing them
  # with 502. Existing streams stay on the slot that started them.
  handle @chat_api {
    reverse_proxy {$CADDY_CHAT_UPSTREAM_HOST}:{$CADDY_CHAT_UPSTREAM_PORT} {$CADDY_CHAT_UPSTREAM_HOST}:{$CADDY_CHAT_B_UPSTREAM_PORT} {
      import chat_slot_routing
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  @api path /api/* /public-api/* /healthz
  handle @api {
    reverse_proxy {$CADDY_ADMIN_UPSTREAM_HOST}:{$CADDY_ADMIN_UPSTREAM_PORT} {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  handle /internal/* {
    respond 404
  }

  # Desktop companion installers live outside the frontend dist directory so
  # frontend-only deploys cannot delete the download files.
  handle_path /downloads/local-bridge/* {
    root * /usr/local/agent-studio/downloads/local-bridge
    header Content-Disposition "attachment"
    file_server
  }

  @missing_js_asset {
    path /assets/*.js
    not file
  }
  handle @missing_js_asset {
    rewrite * /stale-asset-reload.js
    header Cache-Control "no-store"
    file_server
  }

  handle /assets/* {
    file_server
  }

  handle /version.json {
    header Cache-Control "no-store"
    file_server
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}

# Independent site definitions, such as explicit deny rules for a server IP,
# are kept outside Agent Studio and must survive generated config refreshes.
import /etc/caddy/sites/*
