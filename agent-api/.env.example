SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_FROM=
AUTH_EMAIL_DEBUG=true
BRAND_EMAIL_CREDENTIAL_SECRET=replace-with-a-separate-random-secret
ACCESS_REQUEST_INTERNAL_EMAIL_DOMAINS=baicells.com
ACCESS_REQUEST_PUBLIC_EMAIL_BLOCKLIST_EXTRA=
ACCESS_REQUEST_DEFAULT_TRIAL_DAYS=14
ORG_SYNC_ENABLED=false
