NODE_ENV=development
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://agent_studio:agent_studio_dev@127.0.0.1:55432/agent_studio?schema=public
AGENT_API_TOKEN=
ACTION_CONNECTOR_ALLOWED_ORIGINS=
DWS_ENABLED=true
DWS_BINARY_PATH=/usr/local/bin/dws
DWS_BWRAP_PATH=/usr/bin/bwrap
DWS_USER_HOME_ROOT=./temp/dws-users
DWS_EXECUTION_TIMEOUT_MS=900000
DEFAULT_MODEL=gpt-5.4
DEFAULT_REASONING_EFFORT=high
DEFAULT_WORKSPACE=..
SESSION_WORKSPACE_ROOT=../sessions
USER_WORKSPACE_STORAGE_ROOT=./temp/user-workspaces
SESSION_TTL_MINUTES=0
SESSION_COOKIE_SECRET=replace-with-a-local-random-secret
SESSION_COOKIE_SECURE=false
WORKSPACE_WHITELIST=..
