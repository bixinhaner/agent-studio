generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                @id @default(cuid())
  userType           String                @default("internal_employee") @map("user_type")
  primaryOrganizationId String?            @map("primary_organization_id")
  primaryOrganization Organization?        @relation("UserPrimaryOrganization", fields: [primaryOrganizationId], references: [id], onDelete: SetNull)
  externalId         String?               @unique @map("external_id")
  email              String?
  displayName        String?               @map("display_name")
  role               String                @default("employee")
  status             String                @default("active")
  statusSource       String                @default("sync") @map("status_source")
  syncState          String                @default("active") @map("sync_state")
  manualDisabled     Boolean               @default(false) @map("manual_disabled")
  adminNote          String?               @map("admin_note")
  preferencesJson    Json?                 @map("preferences_json")
  lastSyncedAt       DateTime?             @map("last_synced_at")
  dingtalkOpenId     String?               @map("dingtalk_open_id")
  dingtalkUserId     String?               @unique @map("dingtalk_user_id")
  dingtalkCorpId     String?               @map("dingtalk_corp_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  threads            Thread[]
  runtimeSessions    RuntimeSession[]
  authIdentities     AuthIdentity[]
  organizationMemberships OrganizationMembership[] @relation("OrganizationMembershipUser")
  organizationMembershipInvites OrganizationMembership[] @relation("OrganizationMembershipInvitedBy")
  ownedOrganizations Organization[]        @relation("OrganizationOwner")
  organizationInvitesSent OrganizationInvite[] @relation("OrganizationInviteInvitedBy")
  organizationInvitesAccepted OrganizationInvite[] @relation("OrganizationInviteAcceptedBy")
  organizationRoleAssignments OrganizationRoleAssignment[] @relation("OrganizationRoleAssignmentUser")
  departmentMemberships DepartmentMembership[]
  triggeredSyncJobs   SyncJob[]             @relation("SyncJobTriggeredBy")
  userRoles          UserRole[]
  auditLogEntries    AdminAuditLog[]       @relation("AdminAuditActor")
  threadSharesCreated ThreadShare[]         @relation("ThreadShareCreatedBy")
  threadSharesRevoked ThreadShare[]         @relation("ThreadShareRevokedBy")
  threadComments     ThreadComment[]        @relation("ThreadCommentAuthor")
  threadAssignmentsOwned ThreadAssignment[]  @relation("ThreadAssignmentOwner")
  threadAssignmentsCreated ThreadAssignment[] @relation("ThreadAssignmentCreatedBy")
  threadFollowers    ThreadFollower[]       @relation("ThreadFollowerUser")
  threadFollowersAdded ThreadFollower[]     @relation("ThreadFollowerAddedBy")
  threadPublicSharesCreated ThreadPublicShare[] @relation("ThreadPublicShareCreatedBy")
  threadPublicSharesRevoked ThreadPublicShare[] @relation("ThreadPublicShareRevokedBy")
  inboxItems         InboxItem[]
  inboxItemsAsActor   InboxItem[]           @relation("InboxItemSourceActor")
  broadcastMessagesCreated BroadcastMessage[] @relation("BroadcastMessageCreatedBy")
  broadcastMessagesPublished BroadcastMessage[] @relation("BroadcastMessagePublishedBy")
  knowledgeCaptureMarks KnowledgeCaptureMark[] @relation("KnowledgeCaptureMarkMarkedBy")
  productFeedbackSubmitted ProductFeedback[] @relation("ProductFeedbackReporter")
  productFeedbackAssigned ProductFeedback[] @relation("ProductFeedbackAssignee")
  ownedAccessRequests AccessRequest[] @relation("AccessRequestOwner")
  targetAccessRequests AccessRequest[] @relation("AccessRequestTargetUser")
  accessRequestReviewAssignments AccessRequestReviewer[] @relation("AccessRequestReviewerUser")
  accessRequestEvents AccessRequestEvent[] @relation("AccessRequestEventActorUser")

  @@index([email])
  @@index([status, role])
  @@map("users")
}

model Organization {
  id             String                       @id @default(cuid())
  slug           String                       @unique
  name           String
  type           String                       @default("customer")
  status         String                       @default("active")
  ownerUserId    String?                      @map("owner_user_id")
  owner          User?                        @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  settingsJson   Json?                        @map("settings_json")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  primaryUsers   User[]                       @relation("UserPrimaryOrganization")
  memberships    OrganizationMembership[]     @relation("OrganizationMembershipOrganization")
  invites        OrganizationInvite[]         @relation("OrganizationInviteOrganization")
  loginChallenges LoginChallenge[]            @relation("LoginChallengeOrganization")
  roleAssignments OrganizationRoleAssignment[] @relation("OrganizationRoleAssignmentOrganization")
  productFeedback ProductFeedback[] @relation("ProductFeedbackOrganization")
  accessRequests  AccessRequest[]             @relation("AccessRequestTargetOrganization")

  @@index([type, status])
  @@map("organizations")
}

model SubscriptionPlan {
  id                        String               @id @default(cuid())
  slug                      String               @unique
  name                      String
  description               String?
  status                    String               @default("active")
  featureType               String               @default("chat") @map("feature_type")
  monthlyCompletedTurnLimit Int?                 @map("monthly_completed_turn_limit")
  monthlyTokenLimit         Int?                 @map("monthly_token_limit")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  grants                    SubscriptionGrant[]
  requestedByAccessRequests AccessRequest[]      @relation("AccessRequestRequestedPlan")
  approvedByAccessRequests  AccessRequest[]      @relation("AccessRequestApprovedPlan")

  @@index([status, featureType])
  @@map("subscription_plans")
}

model SubscriptionGrant {
  id                         String            @id @default(cuid())
  principalType              String            @map("principal_type")
  principalId                String            @map("principal_id")
  planId                     String?           @map("plan_id")
  plan                       SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  status                     String            @default("active")
  startsAt                   DateTime          @map("starts_at")
  expiresAt                  DateTime?         @map("expires_at")
  cycleAnchorAt              DateTime          @map("cycle_anchor_at")
  completedTurnLimitOverride Int?              @map("completed_turn_limit_override")
  tokenLimitOverride         Int?              @map("token_limit_override")
  note                       String?
  createdByUserId            String?           @map("created_by_user_id")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  @@unique([principalType, principalId])
  @@index([planId])
  @@index([status, expiresAt])
  @@map("subscription_grants")
}

model SubscriptionDenialLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  threadId       String?  @map("thread_id")
  sessionId      String?  @map("session_id")
  principalType  String?  @map("principal_type")
  principalId    String?  @map("principal_id")
  reasonCode     String   @map("reason_code")
  title          String
  detail         String?
  model          String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([reasonCode, createdAt])
  @@map("subscription_denial_logs")
}

model OrganizationMembership {
  id                  String        @id @default(cuid())
  organizationId      String        @map("organization_id")
  organization        Organization  @relation("OrganizationMembershipOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String        @map("user_id")
  user                User          @relation("OrganizationMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  membershipType      String        @default("customer_member") @map("membership_type")
  status              String        @default("active")
  displayNameOverride String?       @map("display_name_override")
  title               String?
  invitedByUserId     String?       @map("invited_by_user_id")
  invitedByUser       User?         @relation("OrganizationMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  joinedAt            DateTime?     @map("joined_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model AuthIdentity {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  providerSubject String    @map("provider_subject")
  email           String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  profileJson     Json?     @map("profile_json")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@index([email])
  @@map("auth_identities")
}

model OrganizationInvite {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  organization     Organization      @relation("OrganizationInviteOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  email            String
  inviteTokenHash  String            @map("invite_token_hash")
  intendedProvider String            @default("email_magic_link") @map("intended_provider")
  roleTemplate     Json?             @map("role_template")
  status           String            @default("pending")
  expiresAt        DateTime          @map("expires_at")
  invitedByUserId  String?           @map("invited_by_user_id")
  invitedByUser    User?             @relation("OrganizationInviteInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  acceptedByUserId String?           @map("accepted_by_user_id")
  acceptedByUser   User?             @relation("OrganizationInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  loginChallenges  LoginChallenge[]  @relation("LoginChallengeInvite")
  accessRequest    AccessRequest?    @relation("AccessRequestInvite")

  @@index([organizationId, status])
  @@index([email, status])
  @@map("organization_invites")
}

model AccessRequest {
  id                   String              @id @default(cuid())
  requestType          String              @default("trial") @map("request_type")
  commercialIntent     String              @default("trial") @map("commercial_intent")
  status               String              @default("submitted")
  applicantEmail       String              @map("applicant_email")
  applicantEmailDomain String              @map("applicant_email_domain")
  contactName          String?             @map("contact_name")
  companyName          String              @map("company_name")
  countryRegion        String?             @map("country_region")
  deviceInfoText       String              @map("device_info_text")
  purchaseDate         DateTime?           @map("purchase_date")
  poNumber             String              @map("po_number")
  snNumber             String?             @map("sn_number")
  salesContactEmail    String              @map("sales_contact_email")
  customerNote         String?             @map("customer_note")
  adminNote            String?             @map("admin_note")
  reviewSummary        String?             @map("review_summary")
  rejectionReason      String?             @map("rejection_reason")
  reviewMode           String              @default("any_to_approve") @map("review_mode")
  minimumApprovals     Int?                @map("minimum_approvals")
  rejectionMode        String              @default("any_to_reject") @map("rejection_mode")
  ownerUserId          String?             @map("owner_user_id")
  ownerUser            User?               @relation("AccessRequestOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  requestedPlanId      String?             @map("requested_plan_id")
  requestedPlan        SubscriptionPlan?   @relation("AccessRequestRequestedPlan", fields: [requestedPlanId], references: [id], onDelete: SetNull)
  approvedPlanId       String?             @map("approved_plan_id")
  approvedPlan         SubscriptionPlan?   @relation("AccessRequestApprovedPlan", fields: [approvedPlanId], references: [id], onDelete: SetNull)
  targetOrganizationId String?             @map("target_organization_id")
  targetOrganization   Organization?       @relation("AccessRequestTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  targetUserId         String?             @map("target_user_id")
  targetUser           User?               @relation("AccessRequestTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  organizationInviteId String?             @unique @map("organization_invite_id")
  organizationInvite   OrganizationInvite? @relation("AccessRequestInvite", fields: [organizationInviteId], references: [id], onDelete: SetNull)
  publicToken          String              @unique @map("public_token")
  lastSubmittedAt      DateTime?           @map("last_submitted_at")
  reviewRequestedAt    DateTime?           @map("review_requested_at")
  approvedAt           DateTime?           @map("approved_at")
  rejectedAt           DateTime?           @map("rejected_at")
  provisionedAt        DateTime?           @map("provisioned_at")
  invitedAt            DateTime?           @map("invited_at")
  activatedAt          DateTime?           @map("activated_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  reviewers            AccessRequestReviewer[]
  events               AccessRequestEvent[]
  attachments          AccessRequestAttachment[]

  @@index([status, createdAt])
  @@index([salesContactEmail, createdAt])
  @@index([applicantEmail, createdAt])
  @@index([applicantEmailDomain, createdAt])
  @@index([ownerUserId, status])
  @@index([targetOrganizationId, status])
  @@map("access_requests")
}

model AccessRequestAttachment {
  id              String        @id @default(cuid())
  accessRequestId String        @map("access_request_id")
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  kind            String        @default("purchase_proof")
  originalName    String        @map("original_name")
  mimeType        String        @default("application/octet-stream") @map("mime_type")
  sizeBytes       Int           @default(0) @map("size_bytes")
  storagePath     String        @map("storage_path")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([accessRequestId, kind, createdAt])
  @@map("access_request_attachments")
}

model AccessRequestPolicy {
  id                       String   @id @default(cuid())
  policyKey                String   @unique @default("global") @map("policy_key")
  internalEmailDomains     String[] @default(["baicells.com"]) @map("internal_email_domains")
  publicEmailBlocklistExtra String[] @default([]) @map("public_email_blocklist_extra")
  defaultTrialDays         Int      @default(14) @map("default_trial_days")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("access_request_policies")
}

model AccessRequestReviewer {
  id             String        @id @default(cuid())
  accessRequestId String       @map("access_request_id")
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  reviewerEmail   String        @map("reviewer_email")
  reviewerUserId  String?       @map("reviewer_user_id")
  reviewerUser    User?         @relation("AccessRequestReviewerUser", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  deliveryType    String        @default("to") @map("delivery_type")
  decision        String        @default("pending")
  comment         String?
  notifiedAt      DateTime?     @map("notified_at")
  decidedAt       DateTime?     @map("decided_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([accessRequestId, reviewerEmail])
  @@index([reviewerUserId, decision])
  @@index([reviewerEmail, decision])
  @@map("access_request_reviewers")
}

model AccessRequestEvent {
  id              String        @id @default(cuid())
  accessRequestId String        @map("access_request_id")
  accessRequest   AccessRequest @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  eventType       String        @map("event_type")
  actorType       String        @map("actor_type")
  actorUserId     String?       @map("actor_user_id")
  actorUser       User?         @relation("AccessRequestEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail      String?       @map("actor_email")
  title           String
  detail          String?
  metadata        Json?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([accessRequestId, createdAt])
  @@index([eventType, createdAt])
  @@map("access_request_events")
}

model LoginChallenge {
  id             String               @id @default(cuid())
  channel        String
  targetRef      String               @map("target_ref")
  challengeHash  String               @map("challenge_hash")
  purpose        String
  organizationId String?              @map("organization_id")
  organization   Organization?        @relation("LoginChallengeOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  inviteId       String?              @map("invite_id")
  invite         OrganizationInvite?  @relation("LoginChallengeInvite", fields: [inviteId], references: [id], onDelete: SetNull)
  expiresAt      DateTime             @map("expires_at")
  consumedAt     DateTime?            @map("consumed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@index([targetRef, purpose, expiresAt])
  @@index([organizationId, purpose])
  @@map("login_challenges")
}

model OrganizationRoleAssignment {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation("OrganizationRoleAssignmentOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String        @map("user_id")
  user           User          @relation("OrganizationRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId         String        @map("role_id")
  role           Role          @relation("OrganizationRoleAssignmentRole", fields: [roleId], references: [id], onDelete: Cascade)
  isPrimary      Boolean       @default(false) @map("is_primary")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, userId, isPrimary])
  @@index([roleId])
  @@map("organization_role_assignments")
}

model Role {
  id             String           @id @default(cuid())
  /// Global roles use organizationId = NULL and rely on a partial unique index in SQL migration.
  organizationId String?          @map("organization_id")
  slug           String
  name           String
  description    String?
  isSystem       Boolean          @default(false) @map("is_system")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  organizationRoleAssignments OrganizationRoleAssignment[] @relation("OrganizationRoleAssignmentRole")
  rolePermissions RolePermission[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id             String           @id @default(cuid())
  key            String           @unique
  name           String
  description    String?
  category       String
  isSystem       Boolean          @default(true) @map("is_system")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  /// At most one primary role per user is enforced by a partial unique index in SQL migration.
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId, isPrimary])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  actionType     String   @map("action_type")
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  beforePayload  Json?    @map("before_payload")
  afterPayload   Json?    @map("after_payload")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actorUser User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}

model Department {
  id                 String                 @id @default(cuid())
  organizationId     String?                @map("organization_id")
  externalId         String                 @unique @map("external_id")
  name               String
  parentDepartmentId String?                @map("parent_department_id")
  sortOrder          Int                    @default(0) @map("sort_order")
  status             String                 @default("active")
  lastSyncedAt       DateTime?              @map("last_synced_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  parentDepartment   Department?            @relation("DepartmentTree", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[]           @relation("DepartmentTree")
  memberships        DepartmentMembership[]

  @@index([parentDepartmentId])
  @@map("departments")
}

model DepartmentMembership {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  departmentId String      @map("department_id")
  isPrimary    Boolean     @default(false) @map("is_primary")
  source       String      @default("sync")
  lastSyncedAt DateTime?   @map("last_synced_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([departmentId, createdAt])
  @@unique([userId, departmentId])
  @@map("department_memberships")
}

model SyncJob {
  id                String          @id @default(cuid())
  organizationId    String?         @map("organization_id")
  provider          String          @default("dingtalk")
  scopeType         String          @map("scope_type")
  scopeExternalId   String?         @map("scope_external_id")
  status            String          @default("pending")
  triggerType       String          @map("trigger_type")
  triggeredByUserId String?         @map("triggered_by_user_id")
  startedAt         DateTime?       @map("started_at")
  finishedAt        DateTime?       @map("finished_at")
  summary           Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  triggeredByUser   User?           @relation("SyncJobTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  events            SyncJobEvent[]
  snapshots         SyncSnapshot[]
  diffs             SyncDiff[]

  @@index([status, createdAt])
  @@index([scopeType, scopeExternalId])
  @@map("sync_jobs")
}

model SyncJobEvent {
  id        String    @id @default(cuid())
  syncJobId String    @map("sync_job_id")
  level     String
  eventType String    @map("event_type")
  message   String
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  syncJob   SyncJob   @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, createdAt])
  @@map("sync_job_events")
}

model SyncSnapshot {
  id              String    @id @default(cuid())
  syncJobId       String    @map("sync_job_id")
  entityType      String    @map("entity_type")
  scopeType       String    @map("scope_type")
  scopeExternalId String?   @map("scope_external_id")
  snapshotPayload Json      @map("snapshot_payload")
  createdAt       DateTime  @default(now()) @map("created_at")
  syncJob         SyncJob   @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, entityType])
  @@map("sync_snapshots")
}

model SyncDiff {
  id               String    @id @default(cuid())
  syncJobId        String    @map("sync_job_id")
  entityType       String    @map("entity_type")
  entityExternalId String?   @map("entity_external_id")
  changeType       String    @map("change_type")
  beforePayload    Json?     @map("before_payload")
  afterPayload     Json?     @map("after_payload")
  createdAt        DateTime  @default(now()) @map("created_at")
  syncJob          SyncJob   @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, entityType])
  @@map("sync_diffs")
}

model Thread {
  id              String            @id @default(cuid())
  organizationId  String?           @map("organization_id")
  userId          String?           @map("user_id")
  title           String?
  status          ThreadStatus      @default(active)
  model           String?
  reasoningEffort String?           @map("reasoning_effort")
  workspace       String?
