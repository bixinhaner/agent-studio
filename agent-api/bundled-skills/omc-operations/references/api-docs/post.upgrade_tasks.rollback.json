{
  "schemaVersion": "1.0",
  "operationId": "post.upgrade_tasks.rollback",
  "method": "POST",
  "path": "/api/v1/upgrade-tasks/rollback",
  "handler": "github.com/omcgo/omcgo/internal/software.(*Handler).CreateRollback-fm",
  "category": "upgrade-tasks",
  "title": "升级任务 - 升级任务回滚",
  "summary": "升级任务 - 升级任务回滚",
  "description": "升级任务：将任务或版本回退到上一状态",
  "intents": [
    "升级任务 - 升级任务回滚",
    "升级任务：将任务或版本回退到上一状态",
    "upgrade-tasks",
    "升级任务",
    "rollback",
    "upgrade tasks"
  ],
  "tags": [
    "upgrade-tasks",
    "升级任务",
    "rollback"
  ],
  "risk": "low",
  "confirmationRequired": true,
  "idempotent": false,
  "sideEffects": "会修改业务状态或触发任务；执行前确认目标、范围和影响。操作语义：升级任务 - 升级任务回滚",
  "pathParams": [],
  "queryParams": [],
  "formParams": [],
  "requestBody": {
    "contentType": "application/json",
    "required": true,
    "schema": {
      "goType": "RollbackRequest",
      "properties": {
        "create_suspended": {
          "type": "boolean"
        },
        "create_user": {
          "type": "string"
        },
        "device_ids": {
          "items": {
            "format": "uuid",
            "goType": "uuid.UUID",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "force": {
          "description": "Force 显式允许降级回退（#59 Problem 4 防降级守卫）。默认 false：当回退目标版本\n比设备当前版本更旧（降级，可能回到含已知漏洞的旧镜像）时，整批拒绝并要求显式\n确认。Force=true 表示运维已知情并批准降级。仅作用于「带 TargetFirmwareID 的显式\n目标版本回退」——回退到设备自身旧 bank（不指定 target）天然就是回旧版本，是回退\n的本意，不受此守卫约束。",
          "type": "boolean"
        },
        "reason": {
          "description": "Audit fields (T-0021). All optional for backwards compatibility.\nSource defaults to RollbackSourceManual when empty.",
          "type": "string"
        },
        "scheduled_at": {
          "description": "ScheduledAt 指定回退任务的计划执行时间，语义与 BatchUpgradeRequest 一致。",
          "format": "date-time",
          "goType": "time.Time",
          "nullable": true,
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target_firmware_id": {
          "format": "uuid",
          "goType": "uuid.UUID",
          "nullable": true,
          "type": "string"
        },
        "task_name": {
          "type": "string"
        }
      },
      "required": [
        "create_user",
        "device_ids",
        "task_name"
      ],
      "type": "object"
    }
  },
  "responses": {
    "2xx": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "data": {
                "description": "该 Handler 返回的真实业务结果；以实际 API JSON 为准。"
              },
              "msg": {
                "example": "ok",
                "type": "string"
              },
              "ret": {
                "const": 1,
                "type": "integer"
              }
            },
            "required": [
              "ret",
              "msg",
              "data"
            ],
            "type": "object"
          }
        }
      },
      "description": "成功。JSON 接口使用 OMC 标准响应信封；文件或 SSE 接口按 Content-Type 返回二进制或事件流。"
    },
    "4xx": {
      "description": "请求参数、身份、权限或 Agent policy 不允许。不要绕过限制。"
    },
    "5xx": {
      "description": "OMC 内部处理失败。不要编造结果或自动重试非幂等写操作。"
    }
  },
  "contractCoverage": {
    "request": "go-handler",
    "response": "standard-envelope"
  },
  "sources": [
    "runtime-route",
    "go-handler"
  ]
}
