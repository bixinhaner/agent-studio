{
  "schemaVersion": "1.0",
  "operationId": "post.upgrade_tasks",
  "method": "POST",
  "path": "/api/v1/upgrade-tasks",
  "handler": "github.com/omcgo/omcgo/internal/software.(*Handler).CreateUpgradeTask-fm",
  "category": "upgrade-tasks",
  "title": "升级任务 - 创建",
  "summary": "升级任务 - 创建",
  "description": "升级任务：创建新的资源记录",
  "intents": [
    "升级任务 - 创建",
    "升级任务：创建新的资源记录",
    "upgrade-tasks",
    "升级任务",
    "upgrade tasks"
  ],
  "tags": [
    "upgrade-tasks",
    "升级任务"
  ],
  "risk": "low",
  "confirmationRequired": true,
  "idempotent": false,
  "sideEffects": "会修改业务状态或触发任务；执行前确认目标、范围和影响。操作语义：升级任务 - 创建",
  "pathParams": [],
  "queryParams": [],
  "formParams": [],
  "requestBody": {
    "contentType": "application/json",
    "required": true,
    "schema": {
      "goType": "BatchUpgradeRequest",
      "properties": {
        "auto_advance": {
          "type": "boolean"
        },
        "auto_advance_minutes": {
          "goType": "int",
          "type": "integer"
        },
        "canary_stages": {
          "items": {
            "goType": "CanaryStage",
            "properties": {
              "failure_threshold": {
                "description": "failure rate ceiling (1..100)",
                "goType": "int",
                "type": "integer"
              },
              "percent": {
                "description": "cumulative target (1..100)",
                "goType": "int",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "concurrency": {
          "goType": "int",
          "type": "integer"
        },
        "create_suspended": {
          "type": "boolean"
        },
        "device_ids": {
          "items": {
            "format": "uuid",
            "goType": "uuid.UUID",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "download_file_type": {
          "type": "string"
        },
        "firmware_id": {
          "format": "uuid",
          "goType": "uuid.UUID",
          "type": "string"
        },
        "is_keep_config": {
          "type": "boolean"
        },
        "rollback_on_failure": {
          "description": "RollbackOnFailure (T-0021): when true (and Strategy=\"canary\"), a stage\nthat exceeds its failure threshold will pause AND auto-trigger a\nrollback for the already-promoted devices. Default false.",
          "type": "boolean"
        },
        "scheduled_at": {
          "description": "ScheduledAt 指定执行时间。非 nil 且晚于当前时间 → 定时模式（CreateSuspended 被忽略）。\n时间已过 / 为 nil → 按 CreateSuspended 走老语义。",
          "format": "date-time",
          "goType": "time.Time",
          "nullable": true,
          "type": "string"
        },
        "strategy": {
          "description": "Canary strategy (T-0018 / R-101). Strategy defaults to \"full\" (legacy\npath); when \"canary\", CanaryStages drives stage progression. Empty\nCanaryStages falls back to DefaultCanaryStages [1,10,50,100].",
          "type": "string"
        },
        "task_name": {
          "type": "string"
        },
        "task_type": {
          "goType": "TaskType",
          "type": "integer"
        }
      },
      "required": [
        "device_ids",
        "firmware_id",
        "task_name"
      ],
      "type": "object"
    }
  },
  "responses": {
    "2xx": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "data": {
                "description": "该 Handler 返回的真实业务结果；以实际 API JSON 为准。"
              },
              "msg": {
                "example": "ok",
                "type": "string"
              },
              "ret": {
                "const": 1,
                "type": "integer"
              }
            },
            "required": [
              "ret",
              "msg",
              "data"
            ],
            "type": "object"
          }
        }
      },
      "description": "成功。JSON 接口使用 OMC 标准响应信封；文件或 SSE 接口按 Content-Type 返回二进制或事件流。"
    },
    "4xx": {
      "description": "请求参数、身份、权限或 Agent policy 不允许。不要绕过限制。"
    },
    "5xx": {
      "description": "OMC 内部处理失败。不要编造结果或自动重试非幂等写操作。"
    }
  },
  "contractCoverage": {
    "request": "go-handler",
    "response": "standard-envelope"
  },
  "sources": [
    "runtime-route",
    "go-handler"
  ]
}
