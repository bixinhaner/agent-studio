{
  "name": "agent-studio-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:thread-repository": "vitest run src/persistence/thread-repository.test.ts",
    "report:local-codex-usage": "tsx src/ops/local-codex-usage-report.ts",
    "build:local-codex-usage-report": "node scripts/build-local-codex-usage-report.mjs",
    "report:portal-chat-startup": "tsx src/ops/portal-chat-startup-report.ts",
    "messages:recover-graphs": "tsx src/ops/recover-message-graphs.ts",
    "messages:rebuild-recovered-suffixes": "tsx src/ops/rebuild-recovered-message-suffixes.ts",
    "skills:backfill-instruction-reads": "tsx src/ops/backfill-historical-instruction-reads.ts",
    "skills:backfill-presentations": "tsx src/ops/backfill-skill-catalog-presentations.ts",
    "usage:backfill-long-context": "tsx src/ops/backfill-codex-long-context-costs.ts",
    "usage:backfill-cumulative": "tsx src/ops/backfill-codex-cumulative-usage.ts",
    "workspace:migrate": "node dist/ops/migrate-portal-user-workspaces.js",
    "workspace:migrate:dry-run": "tsx src/ops/migrate-portal-user-workspaces.ts --dry-run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "dev:seed": "tsx prisma/seed-dev.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.1",
    "@prisma/client": "^6.6.0",
    "chardet": "^2.2.0",
    "cors": "^2.8.5",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.27.0",
    "prisma": "^6.6.0",
    "supertest": "^7.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
